{
	"tabela": {
		"nome": "PCINTEGRACAOROTASERVICO",
		"campos": [
			{
				"nome": "SOMENTEATUALIZARINTEGRACAOCORE",
				"valor": "N"
			},
			{
				"nome": "ID",
				"valor": "WTA - Buscar Desconto e Acrescimo"
			},
			{
				"nome": "IDEMPRESAAPI",
				"valor": "WINTHOR-WTA"
			},
			{
				"nome": "SERVICO",
				"valor": "WTA - Buscar Desconto e Acrescimo"
			},
			{
				"nome": "LAYOUTCOMUNICACAO",
				"valor": {
					"name": "WTA - Buscar Desconto e Acrescimo",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{TOKEN}}"
							},
							{
								"key": "Accept",
								"value": "*/*"
							}
						],
						"url": {
							"raw": "{{URL_BASE}}/winthor/precos/v1/politica-desconto",
							"query": [
								{
									"key": "pageSize",
									"value": "{{PAGE_SIZE}}"
								},
								{
									"key": "page",
									"value": "{{PAGE}}"
								},
								{
									"key": "lastChange",
									"value": "{{LAST_CHANGE}}"
								},
								{
									"key": "initialSync",
									"value": "{{INITIAL_SYNC}}"
								}
							]
						}
					},
					"response": []
				}
			},
			{
				"nome": "LAYOUTTRANSFORMACAO",
				"valor": [
					{
						"operation": "modify-overwrite-beta",
						"spec": {
							"items": {
								"*": {
									"chaveCampanha": "=concat(@(1,branchId),'-',@(1,campaignId))",
									"baseIdExterno": "=concat('pdvsync-politica-desconto-acrescimo-',@(1,campaignId),'-',@(1,lastChangeDate),'-',@(1,lastChangeDate))",
									"baseIdInterno": "=concat(@(1,branchId),'-',@(1,campaignId))",
									"tipoIdInterno": "PDVSYNC-POLITICA-DESCONTO-ACRESCIMO",
									"campaignIdStr": "=toString(@(1,campaignId))",
									"sufixoItem": "=concat('-',@(1,productClassificationId))",
									"idRetaguardaItem": "=concat(@(1,campaignId),'-',@(1,productClassificationId))",
									"situacaoItem": "=toInteger(1)"
								}
							}
						}
					},
					{
						"operation": "shift",
						"spec": {
							"items": {
								"*": {
									"baseIdExterno": "grouped.@(1,chaveCampanha).baseIdExterno",
									"baseIdInterno": "grouped.@(1,chaveCampanha).baseIdInterno",
									"tipoIdInterno": "grouped.@(1,chaveCampanha).tipoIdInterno",
									"regionId": "grouped.@(1,chaveCampanha).item.idRetaguardaRegiao",
									"squareId": "grouped.@(1,chaveCampanha).item.idRetaguardaPraca",
									"branchActivityId": "grouped.@(1,chaveCampanha).item.idRetaguardaRamoAtividade",
									"clientNetId": "grouped.@(1,chaveCampanha).item.idRetaguardaRede",
									"clientId": "grouped.@(1,chaveCampanha).item.idRetaguardaCliente",
									"supplierId": "grouped.@(1,chaveCampanha).item.idRetaguardaFornecedor",
									"codeCategory": "grouped.@(1,chaveCampanha).item.idRetaguardaCategoria",
									"codeSubCategory": "grouped.@(1,chaveCampanha).item.idRetaguardaSubCategoria",
									"codeDepartment": "grouped.@(1,chaveCampanha).item.idRetaguardaDepartamento",
									"brandcode": "grouped.@(1,chaveCampanha).item.idRetaguardaMarca",
									"codeSection": "grouped.@(1,chaveCampanha).item.idRetaguardaSecao",
									"restrictionTermTypeCode": "grouped.@(1,chaveCampanha).item.idRetaguardaRestricaoPagamentoCondicao",
									"paymentTermId": "grouped.@(1,chaveCampanha).item.idRetaguardaPagamentoCondicao",
									"startQtd": "grouped.@(1,chaveCampanha).item.quantidadeInicial",
									"endQtd": "grouped.@(1,chaveCampanha).item.quantidadeFinal",
									"startDate": "grouped.@(1,chaveCampanha).item.DataHoraVigenciaInicial",
									"endDate": "grouped.@(1,chaveCampanha).item.DataHoraVigenciaFinal",
									"percentageValue": "grouped.@(1,chaveCampanha).item.valor",
									"type": "grouped.@(1,chaveCampanha).item.tipo",
									"branchId": {
										"99": {
											"#{{MASTER_ID_PROPRIETARIO}}": "grouped.@(3,chaveCampanha).item.idProprietario"
										},
										"*": {
											"@1": "grouped.@(3,chaveCampanha).item.idProprietario"
										}
									},
									"skuId": "grouped.@(1,chaveCampanha).item.idRetaguardaProduto",
									"packingId": "grouped.@(1,chaveCampanha).item.idRetaguardaProdutoEmbalagem",
									"allPackages": "grouped.@(1,chaveCampanha).item.usarTodasEmbalagens",
									"campaignIdStr": "grouped.@(1,chaveCampanha).item.idRetaguarda",
									"active": {
										"true": {
											"#1": "grouped.@(3,chaveCampanha).item.situacao"
										},
										"*": {
											"#0": "grouped.@(3,chaveCampanha).item.situacao"
										}
									},
									"priority": {
										"S": {
											"#true": "grouped.@(3,chaveCampanha).item.prioritaria"
										},
										"*": {
											"#false": "grouped.@(3,chaveCampanha).item.prioritaria"
										}
									},
									"productClassificationId": {
										"*": {
											"@1": "grouped.@(3,chaveCampanha).item.regraDescontoAcrescimoItens.[&3].idRetaguardaClassificacaoProduto",
											"@(2,idRetaguardaItem)": "grouped.@(3,chaveCampanha).item.regraDescontoAcrescimoItens.[&3].idRetaguarda",
											"@(2,situacaoItem)": "grouped.@(3,chaveCampanha).item.regraDescontoAcrescimoItens.[&3].situacao",
											"@(2,sufixoItem)": "grouped.@(3,chaveCampanha).sufixos[]"
										}
									}
								}
							}
						}
					},
					{
						"operation": "cardinality",
						"spec": {
							"grouped": {
								"*": {
									"baseIdExterno": "ONE",
									"baseIdInterno": "ONE",
									"tipoIdInterno": "ONE",
									"sufixos": "MANY",
									"item": {
										"*": "ONE",
										"regraDescontoAcrescimoItens": "MANY"
									}
								}
							}
						}
					},
					{
						"operation": "shift",
						"spec": {
							"grouped": {
								"*": "rows[]"
							}
						}
					},
					{
						"operation": "default",
						"spec": {
							"rows[]": {
								"*": {
									"sufixos": [
										""
									]
								}
							}
						}
					},
					{
						"operation": "modify-overwrite-beta",
						"spec": {
							"rows": {
								"*": {
									"sufixoUnificado": "=join('',@(1,sufixos))",
									"idExternoFinal": "=concat(@(1,baseIdExterno),@(1,sufixoUnificado))",
									"idInternoFinal": "=concat(@(1,baseIdInterno),@(1,sufixoUnificado))"
								}
							}
						}
					},
					{
						"operation": "shift",
						"spec": {
							"rows": {
								"*": {
									"idExternoFinal": "idExterno[]",
									"idInternoFinal": "idInterno[]",
									"tipoIdInterno": "tipoIdInterno[]",
									"item": "items[]"
								}
							}
						}
					},
					{
						"operation": "modify-overwrite-beta",
						"spec": {
							"items": {
								"*": {
									"regraDescontoAcrescimoItens": "=recursivelySquashNulls"
								}
							}
						}
					},
					{
						"operation": "default",
						"spec": {
							"_attr_access": "items",
							"items[]": {
								"*": {
									"idInquilino": "{{ID_INQUILINO}}",
									"loteOrigem": "{{LOTE_ORIGEM}}"
								}
							}
						}
					}
				]
			},
			{
				"nome": "ATIVO",
				"valor": "S"
			},
			{
				"nome": "AUTENTICADOR",
				"valor": "N"
			},
			{
				"nome": "DATASINCRONISMO",
				"valor": "14-NOV-23"
			},
			{
				"nome": "REFRESHTOKEN",
				"valor": ""
			},
			{
				"nome": "TIPOPROCESSO",
				"valor": "BUSCAR"
			}
		]
	}
}
