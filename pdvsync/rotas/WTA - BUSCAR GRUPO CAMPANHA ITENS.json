{
	"tabela": {
		"nome": "PCINTEGRACAOROTASERVICO",
		"campos": [
			{
				"nome": "SOMENTEATUALIZARINTEGRACAOCORE",
				"valor": "N"
			},
			{
				"nome": "ID",
				"valor": "WTA - Buscar Grupo Campanha Itens"
			},
			{
				"nome": "IDEMPRESAAPI",
				"valor": "WINTHOR-WTA"
			},
			{
				"nome": "SERVICO",
				"valor": "WTA - Buscar Grupo Campanha Itens"
			},
			{
				"nome": "LAYOUTCOMUNICACAO",
				"valor": {
					"name": "WTA - Buscar Grupo Campanha Itens",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{TOKEN}}"
							},
							{
								"key": "Accept",
								"value": "*/*"
							}
						],
						"url": {
							"raw": "{{URL_BASE}}/winthor/cadastros/v1/grupo-campanha/itens",
							"query": [
								{
									"key": "pageSize",
									"value": "{{PAGE_SIZE}}"
								},
								{
									"key": "page",
									"value": "{{PAGE}}"
								},
								{
									"key": "lastChange",
									"value": "{{DATAALTERACAO}}"
								}
							]
						}
					},
					"response": []
				}
			},
			{
				"nome": "LAYOUTTRANSFORMACAO",
				"valor": [
					{
						"operation": "modify-overwrite-beta",
						"spec": {
							"items": {
								"*": {
									"idRetaguarda": "=concat(@(1,groupCampaignId), '-', @(1,productId), '-', @(1,barCode))",
									"idExterno": "=concat('pdvsync-associacao-produto-classificado-', @(1,idRetaguarda), '-', @(1,lastChange))",
									"idInterno": "=concat('', @(1,idRetaguarda))",
									"idRetaguardaProduto": "=concat(@(1, productId), '-', @(1, barCode))",
									"tipoIdInterno": "PDVSYNC-ASSOCIACAO-PRODUTO-CLASSIFICADO",
									"ordem": 1
								}
							}
						}
					},
					{
						"operation": "shift",
						"spec": {
							"items": {
								"*": {
									"idExterno": "idExterno[]",
									"idInterno": "idInterno[]",
									"tipoIdInterno": "tipoIdInterno[]",
									"idRetaguarda": "items.[&1].idRetaguarda",
									"idRetaguardaProduto": "items.[&1].idRetaguardaProduto",
									"groupCampaignId": "items.[&1].idRetaguardaClassificacaoProduto",
									"active": {
										"false": {
											"#0": "items.[&3].situacao"
										},
										"true": {
											"#1": "items.[&3].situacao"
										}
									},
									"ordem": "items.[&1].ordem"
								}
							}
						}
					},
					{
						"operation": "modify-overwrite-beta",
						"spec": {
							"items": {
								"*": {
									"idRetaguarda": "=toString",
									"idRetaguardaProduto": "=toString",
									"idRetaguardaClassificacaoProduto": "=toString",
									"situacao": "=toInteger"
								}
							}
						}
					},
					{
						"operation": "default",
						"spec": {
							"_attr_access": "items",
							"items[]": {
								"*": {
									"idInquilino": "{{ID_INQUILINO}}",
									"idProprietario": "{{MASTER_ID_PROPRIETARIO}}",
									"loteOrigem": "{{LOTE_ORIGEM}}"
								}
							}
						}
					}
				]
			},
			{
				"nome": "ATIVO",
				"valor": "S"
			},
			{
				"nome": "AUTENTICADOR",
				"valor": "N"
			},
			{
				"nome": "DATASINCRONISMO",
				"valor": "08-SET-26"
			},
			{
				"nome": "REFRESHTOKEN",
				"valor": ""
			},
			{
				"nome": "TIPOPROCESSO",
				"valor": "BUSCAR"
			}
		]
	}
}
