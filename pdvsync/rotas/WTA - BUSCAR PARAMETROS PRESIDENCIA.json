{
	"tabela": {
		"nome": "PCINTEGRACAOROTASERVICO",
		"campos": [
			{
				"nome": "SOMENTEATUALIZARINTEGRACAOCORE",
				"valor": "N"
			},
			{
				"nome": "ID",
				"valor": "WTA - Buscar Parametros Presidencia"
			},
			{
				"nome": "IDEMPRESAAPI",
				"valor": "WINTHOR-WTA"
			},
			{
				"nome": "SERVICO",
				"valor": "WTA - Buscar Parametros Presidencia"
			},
			{
				"nome": "LAYOUTCOMUNICACAO",
				"valor": {
					"name": "WTA - Buscar Parametros Presidencia",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{TOKEN}}"
							},
							{
								"key": "Accept",
								"value": "*/*"
							}
						],
						"url": {
							"raw": "{{URL_BASE}}/winthor/cadastros/v1/parametro",
							"query": [
								{
									"key": "pageSize",
									"value": "{{PAGE_SIZE}}"
								},
								{
									"key": "page",
									"value": "{{PAGE}}"
								},
								{
									"key": "lastChange",
									"value": "{{LASTCHANGE}}"
								},
								{
									"key": "branchId",
									"value": "{{BRANCHID}}"
								}
							]
						}
					},
					"response": []
				}
			},
			{
				"nome": "LAYOUTTRANSFORMACAO",
				"valor": [
					{
						"operation": "modify-overwrite-beta",
						"spec": {
							"items": {
								"*": {
									"idRetaguarda": "=concat(@(1,backendName),'-',@(1,branchId))",
									"idExterno": "=concat('pdvsync-parametros-presidencia-', @(1,backendName),'-',@(1,branchId),'-',@(1,lastChange))",
									"idInterno": "=concat(@(1,backendName),'-',@(1,branchId))",
									"tipoIdInterno": "PDVSYNC-PARAMETROS-PRESIDENCIA"
								}
							}
						}
					},
					{
						"operation": "shift",
						"spec": {
							"items": {
								"*": {
									"pdvId": "items[&1].chave",
									"idRetaguarda": "items[&1].idRetaguarda",
									"dataType": {
										"B": {
											"@(2,value)": {
												"S": {
													"#1": "items[&5].valor"
												},
												"*": {
													"#0": "items[&5].valor"
												}
											}
										},
										"*": {
											"@(2,value)": "items[&3].valor"
										}
									},
									"idExterno": "idExterno",
									"idInterno": "idInterno",
									"tipoIdInterno": "tipoIdInterno",
									"branchId": {
										"99": {
											"#{{MASTER_ID_PROPRIETARIO}}": "items[&3].idProprietario"
										},
										"*": {
											"@(2,branchId)": "items[&3].idProprietario"
										}
									}
								}
							}
						}
					},
					{
						"operation": "modify-overwrite-beta",
						"spec": {
							"items": {
								"*": {
									"chave": "=toInteger"
								}
							}
						}
					},
					{
						"operation": "default",
						"spec": {
							"_attr_access": "items",
							"items[]": {
								"*": {
									"idInquilino": "{{ID_INQUILINO}}",
									"loteOrigem": "{{LOTE_ORIGEM}}",
									"situacao": 1
								}
							}
						}
					}
				]
			},
			{
				"nome": "ATIVO",
				"valor": "S"
			},
			{
				"nome": "AUTENTICADOR",
				"valor": "N"
			},
			{
				"nome": "DATASINCRONISMO",
				"valor": "14-NOV-23"
			},
			{
				"nome": "REFRESHTOKEN",
				"valor": ""
			},
			{
				"nome": "TIPOPROCESSO",
				"valor": "BUSCAR"
			}
		]
	}
}