{
  "tabela": {
    "nome": "PCINTEGRACAOROTASERVICO",
    "campos": [
      {
        "nome": "REFRESHTOKEN",
        "valor": "N"
      },
      {
        "nome": "SOMENTEATUALIZARINTEGRACAOCORE",
        "valor": "N"
      },
      {
        "nome": "ID",
        "valor": "COLENT - Buscar Entrega"
      },
      {
        "nome": "IDEMPRESAAPI",
        "valor": "COLETA-ENTREGA"
      },
      {
        "nome": "SERVICO",
        "valor": "COLENT - Buscar Entrega"
      },
      {
        "nome": "LAYOUTCOMUNICACAO",
        "valor": {
          "name": "COLENT - Buscar Entrega",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{TOKEN}}"
              },
              {
                "key": "Accept",
                "value": " */*"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{URL_BASE}}/query/api/v1/coletasEntregas",
              "query": [
                {
                  "key": "tipo",
                  "value": "ENTREGA"
                },
                {
                  "key": "externalId",
                  "value": "{{NUMTRANSVENDA}}"
                }
              ]
            }
          },
          "response": []
        }
      },
      {
        "nome": "LAYOUTTRANSFORMACAO",
        "valor": [
          {
            "operation": "modify-overwrite-beta",
            "spec": {
              "items": {
                "*": {
                  "idExterno": "=concat('coleta-entrega-busca-entrega-',@(1,id), '', @(1,dataSituacao))"
                }
              }
            }
          },
          {
            "operation": "shift",
            "spec": {
              "items": {
                "*": {
                  "idExterno": "idExterno",
                  "externalId": "items.[&1].numTransVenda",
                  "id": "items.[&1].idExterno",
                  "dataSituacao": "items.[&1].dataSituacao"
                }
              }
            }
          },
          {
            "operation": "default",
            "spec": {
              "_attr_access": "items"
            }
          }
        ]
      },
      {
        "nome": "ATIVO",
        "valor": "N"
      },
      {
        "nome": "TIPOPROCESSO",
        "valor": "BUSCAR"
      },
      {
        "nome": "AUTENTICADOR",
        "valor": "N"
      },
      {
        "nome": "DATASINCRONISMO",
        "valor": ""
      }
    ]
  }
}