{
  "tabela": {
    "nome": "PCINTEGRACAOROTASERVICO",
    "campos": [
      {
        "nome": "REFRESHTOKEN",
        "valor": "N"
      },
      {
        "nome": "SOMENTEATUALIZARINTEGRACAOCORE",
        "valor": "N"
      },
      {
        "nome": "ID",
        "valor": "COLENT - Busca Cliente"
      },
      {
        "nome": "IDEMPRESAAPI",
        "valor": "COLETA-ENTREGA"
      },
      {
        "nome": "SERVICO",
        "valor": "COLENT - Busca Cliente"
      },
      {
        "nome": "LAYOUTCOMUNICACAO",
        "valor": {
          "name": "COLETA-ENTREGA - Busca Cliente",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{TOKEN}}"
              },
              {
                "key": "Accept",
                "value": " */*"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{URL_BASE}}/query/api/v1/clientes/{{IDEXTERNO}}",
              "query": []
            }
          },
          "response": []
        }
      },
      {
        "nome": "LAYOUTTRANSFORMACAO",
        "valor": [
          {
            "operation": "modify-overwrite-beta",
            "spec": {
              "idExterno": "=concat('busca-cliente-colent-',@(1,id),'-','{{SYSDATE}}')"
            }
          },
          {
            "operation": "shift",
            "spec": {
              "idExterno": "idExterno",
              "documentoIdentificacao": "cgc",
              "enderecos": {
                "*": {
                  "tipoEndereco": "enderecos[&1].tipoEndereco",
                  "localidade": {
                    "id": "enderecos[&2].id",
                    "componentesEnderecos": {
                      "*": {
                        "nomeLongo": "enderecos[&4].componentes.@(1,tipoComponente)"
                      }
                    }
                  }
                }
              }
            }
          },
          {
            "operation": "shift",
            "spec": {
              "idExterno": "idExterno",
              "cgc": "cgc",
              "enderecos": {
                "*": {
                  "tipoEndereco": "enderecos[&1].tipoEndereco",
                  "id": "enderecos[&1].id",
                  "componentes": {
                    "BAIRRO": "enderecos[&2].bairro",
                    "LOGRADOURO": "enderecos[&2].logradouro",
                    "MUNICIPIO": "enderecos[&2].municipio",
                    "ESTADO": "enderecos[&2].estado",
                    "NUMERO_LOGRADOURO": "enderecos[&2].numero",
                    "CODIGO_POSTAL": "enderecos[&2].cep"
                  }
                }
              }
            }
          }
        ]
      },
      {
        "nome": "ATIVO",
        "valor": "S"
      },
      {
        "nome": "TIPOPROCESSO",
        "valor": "BUSCAR"
      },
      {
        "nome": "AUTENTICADOR",
        "valor": "N"
      },
      {
        "nome": "DATASINCRONISMO",
        "valor": ""
      }
    ]
  }
}