{
  "tabela": {
    "nome": "PCINTEGRACAOROTASERVICO",
    "campos": [
      {
        "nome": "REFRESHTOKEN",
        "valor": "N"
      },
      {
        "nome": "SOMENTEATUALIZARINTEGRACAOCORE",
        "valor": "N"
      },
      {
        "nome": "ID",
        "valor": "COLENT - Busca Localidade"
      },
      {
        "nome": "IDEMPRESAAPI",
        "valor": "COLETA-ENTREGA"
      },
      {
        "nome": "SERVICO",
        "valor": "COLENT - Busca Localidade"
      },
      {
        "nome": "LAYOUTCOMUNICACAO",
        "valor": {
          "name": "COLENT - Busca Localidade",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{TOKEN}}"
              },
              {
                "key": "Accept",
                "value": " */*"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{URL_BASE}}/query/api/v1/localidades",
              "query": [
                {
                  "key": "logradouro",
                  "value": "{{LOGRADOURO_LOCALIDADE}}"
                },
                {
                  "key": "cep",
                  "value": "{{CEP_LOCALIDADE}}"
                },
                {
                  "key": "numero",
                  "value": "{{NUMERO_LOCALIDADE}}"
                }
              ],
              "host": [
                "{{URL_BASE}}"
              ]
            }
          },
          "response": []
        }
      },
      {
        "nome": "LAYOUTTRANSFORMACAO",
        "valor": [
          {
            "operation": "shift",
            "spec": {
              "items": {
                "*": {
                  "componentesEnderecos": {
                    "*": {
                      "tipoComponente": {
                        "LOGRADOURO": {
                          "@2,nomeLongo": "items[&3].logradouro"
                        },
                        "CODIGO_POSTAL": {
                          "@2,nomeLongo": "items[&3].cep"
                        },
                        "NUMERO_LOGRADOURO": {
                          "@2,nomeLongo": "items[&3].numero"
                        }
                      }
                    }
                  },
                  "id": "items[&1].id"
                }
              }
            }
          },
          {
            "operation": "shift",
            "spec": {
              "items": {
                "*": {
                  "idExterno": "idExterno[]",
                  "id": "items[0].id",
                  "idInterno": "items[0].idInterno",
                  "logradouro": "items[0].logradouro",
                  "cep": "items[0].cep",
                  "numero": "items[0].numero"
                }
              }
            }
          },
          {
            "operation": "modify-overwrite-beta",
            "spec": {
              "items": {
                "*": {
                  "idInterno": "=concat(@(1,logradouro),'|',@(1,numero),'|',@(1,cep))",
                  "idExterno": "=concat('coleta-entrega-id-localizacao-',@(1,id))"
                }
              }
            }
          },
          {
            "operation": "shift",
            "spec": {
              "items": {
                "*": {
                  "idExterno": "idExterno[]",
                  "id": "items[0].idexterno",
                  "idInterno": "items[0].idinterno"
                }
              }
            }
          },
          {
            "operation": "default",
            "spec": {
              "items[]": {
                "*": {
                  "campo": "LOGRADOURO|NUMERO|CEP",
                  "tabela": "PCCLIENT|PCCLIENTENDENT"
                }
              },
              "_attr_access": "items"
            }
          }
        ]
      },
      {
        "nome": "ATIVO",
        "valor": "S"
      },
      {
        "nome": "TIPOPROCESSO",
        "valor": ""
      },
      {
        "nome": "AUTENTICADOR",
        "valor": "N"
      },
      {
        "nome": "DATASINCRONISMO",
        "valor": ""
      }
    ]
  }
}